    { "op": "set", "sheet": "Tasks", "cell": "I6", "formula": "=AVERAGE(I7:I9)" },
    { "op": "set", "sheet": "Tasks", "cell": "G10", "formula": "=MIN(G11:G14)" },
    { "op": "set", "sheet": "Tasks", "cell": "H10", "formula": "=MAX(H11:H14)" },
    { "op": "set", "sheet": "Tasks", "cell": "I10", "formula": "=AVERAGE(I11:I14)" },
    { "op": "set", "sheet": "Tasks", "cell": "G15", "formula": "=MIN(G16:G20)" },
    { "op": "set", "sheet": "Tasks", "cell": "H15", "formula": "=MAX(H16:H20)" },
    { "op": "set", "sheet": "Tasks", "cell": "I15", "formula": "=AVERAGE(I16:I20)" },
    { "op": "set", "sheet": "Tasks", "cell": "G21", "formula": "=MIN(G22:G25)" },
    { "op": "set", "sheet": "Tasks", "cell": "H21", "formula": "=MAX(H22:H25)" },
    { "op": "set", "sheet": "Tasks", "cell": "I21", "formula": "=AVERAGE(I22:I25)" },
    { "op": "set", "sheet": "Tasks", "cell": "B3", "formula": "=COUNTA(D7:D25)" },
    { "op": "set", "sheet": "Tasks", "cell": "D3", "formula": "=COUNTIF(E7:E25,\"Done\")" },
    { "op": "set", "sheet": "Tasks", "cell": "E3", "formula": "=COUNTIF(E7:E25,\"At risk\")+COUNTIF(E7:E25,\"Blocked\")" },
    { "op": "set", "sheet": "Tasks", "cell": "G3", "formula": "=SUMIF(D7:D25,\"<>\",I7:I25)/B3", "style": { "numFmt": "0%" } },
    { "op": "set", "sheet": "Tasks", "cell": "I3", "formula": "=H25-TODAY()", "style": { "numFmt": "0" } },
    { "op": "addValidation", "sheet": "Tasks", "range": "E7:E9", "rule": { "type": "list", "values": ["Not started", "On track", "At risk", "Blocked", "Done"] } },
    { "op": "addValidation", "sheet": "Tasks", "range": "E11:E14", "rule": { "type": "list", "values": ["Not started", "On track", "At risk", "Blocked", "Done"] } },
    { "op": "addValidation", "sheet": "Tasks", "range": "E16:E20", "rule": { "type": "list", "values": ["Not started", "On track", "At risk", "Blocked", "Done"] } },
    { "op": "addValidation", "sheet": "Tasks", "range": "E22:E25", "rule": { "type": "list", "values": ["Not started", "On track", "At risk", "Blocked", "Done"] } },
    { "op": "addValidation", "sheet": "Tasks", "range": "F7:F25", "rule": { "type": "list", "values": ["Low", "Med", "High"] } },
    { "op": "addValidation", "sheet": "Tasks", "range": "I7:I25", "rule": { "type": "decimal", "min": 0, "max": 1, "prompt": "Progress, from 0% to 100%" } },
    { "op": "addCf", "sheet": "Tasks", "range": "E7:E25", "rule": { "type": "cellIs", "operator": "equal", "values": ["Done"], "style": { "font": { "color": "#1f7a4d", "bold": true } } } },
    { "op": "addCf", "sheet": "Tasks", "range": "E7:E25", "rule": { "type": "cellIs", "operator": "equal", "values": ["At risk"], "style": { "font": { "color": "#b86e00", "bold": true } } } },
    { "op": "addCf", "sheet": "Tasks", "range": "E7:E25", "rule": { "type": "cellIs", "operator": "equal", "values": ["Blocked"], "style": { "font": { "color": "#c0392b", "bold": true } } } },
    { "op": "addCf", "sheet": "Tasks", "range": "H7:H25", "rule": { "type": "expression", "formula": "=AND($D7<>\"\",$H7<TODAY(),$E7<>\"Done\")", "style": { "font": { "color": "#c0392b", "bold": true } } } },
    { "op": "addCf", "sheet": "Tasks", "range": "I7:I25", "rule": { "type": "dataBar", "color": "#3b6fd8", "min": 0, "max": 1 } },

    { "op": "unmerge", "sheet": "Timeline", "range": "D5:P5" },
    { "op": "unmerge", "sheet": "Timeline", "range": "D9:P9" },
