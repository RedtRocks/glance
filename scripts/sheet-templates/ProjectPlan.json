    { "op": "unmerge", "sheet": "Timeline", "range": "D20:P20" },
    { "op": "addCf", "sheet": "Timeline", "range": "D5:P24", "rule": { "type": "expression", "formula": "=AND(Tasks!$D6=\"\",D$4+6>=Tasks!$G6,D$4<=Tasks!$H6)", "style": { "fill": "#9aa7bd" } } },
    { "op": "addCf", "sheet": "Timeline", "range": "D5:P24", "rule": { "type": "expression", "formula": "=AND(D$4+6>=Tasks!$G6,D$4<=Tasks!$H6,D$4+6<Tasks!$G6+(Tasks!$H6-Tasks!$G6)*Tasks!$I6)", "style": { "fill": "#1f7a4d" } } },
    { "op": "addCf", "sheet": "Timeline", "range": "D5:P24", "rule": { "type": "expression", "formula": "=AND(D$4+6>=Tasks!$G6,D$4<=Tasks!$H6)", "style": { "fill": "#3b6fd8" } } },
    { "op": "addCf", "sheet": "Timeline", "range": "D4:P24", "rule": { "type": "expression", "formula": "=AND(TODAY()>=D$4,TODAY()<D$4+7)", "style": { "fill": "#fde9e4" } } },

    { "op": "set", "sheet": "Risks", "range": "B2:G7", "values": [["RISK", "OWNER", "LIKELIHOOD (1-5)", "IMPACT (1-5)", "SCORE", "WHAT WE'RE DOING"], ["Data migration slips", "Kofi", 4, 5, null, "Daily check-in with the data team"], ["Wireframes not signed off", "Hattie", 3, 4, null, "Review session booked for Thu"], ["Payment provider changes API", "Sam", 2, 4, null, "Watch their change log"], ["Support team not ready", "Lena", 2, 3, null, "Training booked w/c 16 Nov"], ["Beta customers drop out", "Priya", 2, 2, null, "Invite 25 to get 20"]] },
    { "op": "set", "sheet": "Risks", "range": "F3:F7", "formula": "=D3*E3" },
