    { "op": "addValidation", "sheet": "Risks", "range": "D3:E7", "rule": { "type": "whole", "min": 1, "max": 5, "prompt": "1 is low, 5 is high" } },
    { "op": "addCf", "sheet": "Risks", "range": "F3:F7", "rule": { "type": "colorScale", "colors": ["#e6f4ea", "#fff3c4", "#f8c9c0"], "min": 1, "max": 25 } },
    { "op": "colWidth", "sheet": "Risks", "cols": "B", "width": 220 },
    { "op": "colWidth", "sheet": "Risks", "cols": "C:F", "width": 100 },
    { "op": "colWidth", "sheet": "Risks", "cols": "G", "width": 260 },

    { "op": "set", "sheet": "Team", "range": "B2:E8", "values": [["INITIALS", "NAME", "ROLE", "TASKS"], ["PN", "Priya", "Project lead", null], ["LB", "Lena", "Research and accessibility", null], ["KM", "Kofi", "Data and back end", null], ["HM", "Hattie", "Design", null], ["RS", "Ravi", "Platform", null], ["SO", "Sam", "Payments and QA", null]] },
    { "op": "set", "sheet": "Team", "range": "E3:E8", "formula": "=COUNTIF(Timeline!$C$5:$C$24,B3)" },
